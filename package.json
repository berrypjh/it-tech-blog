{
  "name": "@it-tech-blog/source",
  "version": "0.0.0",
  "license": "MIT",
  "prettier": "@berrypjh/prettier-config",
  "scripts": {
    "dev": "nx run-many -t dev --projects=@it-tech-blog/main-web,@it-tech-blog/accessibility-zone,@it-tech-blog/react-deep-dive-zone,@it-tech-blog/next-deep-dive-zone --parallel",
    "dev:main": "nx run @it-tech-blog/main-web:dev",
    "dev:a11y": "nx run @it-tech-blog/accessibility-zone:dev",
    "dev:react-deep-dive": "nx run @it-tech-blog/react-deep-dive-zone:dev",
    "dev:next-deep-dive": "nx run @it-tech-blog/next-deep-dive-zone:dev",
    "build": "nx run-many -t build --projects=@it-tech-blog/main-web,@it-tech-blog/accessibility-zone,@it-tech-blog/react-deep-dive-zone,@it-tech-blog/next-deep-dive-zone",
    "build:main": "nx run @it-tech-blog/main-web:build",
    "build:a11y": "nx run @it-tech-blog/accessibility-zone:build",
    "build:react-deep-dive": "nx run @it-tech-blog/react-deep-dive-zone:build",
    "build:next-deep-dive": "nx run @it-tech-blog/next-deep-dive-zone:build",
    "build:mcp:commit": "nx run commit-mcp:build",
    "lint": "nx run-many -t lint --parallel",
    "typecheck": "nx run-many -t typecheck --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "nx run-many -t e2e --parallel",
    "storybook": "nx storybook @it-tech-blog/storybook",
    "build-storybook": "nx build-storybook @it-tech-blog/storybook",
    "storybook:a11y": "concurrently -k -s first -n SB,A11Y \"http-server apps/storybook/storybook-static -p 6006 --silent\" \"wait-on tcp:6006 && test-storybook --url http://localhost:6006 --config-dir apps/storybook/.storybook\"",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@berrypjh/commitlint-config": "^1.0.0",
    "@berrypjh/eslint-config": "^1.0.0",
    "@berrypjh/prettier-config": "^1.0.0",
    "@berrypjh/react-ui": "^1.0.1",
    "@berrypjh/tsconfig": "^1.0.0",
    "lucide-react": "^1.16.0",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/devkit": "22.6.5",
    "@nx/eslint": "22.6.5",
    "@nx/eslint-plugin": "22.6.5",
    "@nx/js": "22.6.5",
    "@nx/next": "22.6.5",
    "@nx/playwright": "22.6.5",
    "@nx/storybook": "22.6.5",
    "@nx/workspace": "22.6.5",
    "@playwright/test": "^1.36.0",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@storybook/test-runner": "^0.24.3",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-playwright": "^2.2.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nx": "22.6.5",
    "nx-ignore": "^19.8.0",
    "postcss": "8.4.38",
    "prettier": "~3.6.2",
    "storybook": "^10.4.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^5.4.21",
    "wait-on": "^9.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
