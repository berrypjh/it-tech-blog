{
  "name": "@it-tech-blog/llm-system-zone",
  "targets": {
    "dev": {
      "options": {
        "command": "next dev",
        "env": {
          "PORT": "4003"
        }
      }
    },
    "start": {
      "options": {
        "command": "next start",
        "env": {
          "PORT": "4003"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test \"src/**/*.spec.mjs\"",
        "cwd": "{projectRoot}"
      },
      "inputs": ["{projectRoot}/src/**/*.ts", "{projectRoot}/src/**/*.spec.mjs"],
      "cache": true
    }
  }
}
